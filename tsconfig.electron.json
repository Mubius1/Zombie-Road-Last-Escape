{
  // tsconfig DEDICATO al wrapper desktop Electron — SEPARATO da tsconfig.json del gioco
  // (che resta noEmit + include solo `src`). Compila i sorgenti TS di `electron/` verso
  // `dist-electron/` come CommonJS. Additivo: non tocca in alcun modo la build del gioco.
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    // Tipi Node disponibili (path, process, ...). @types/node è già in devDependencies.
    "types": ["node"],
    "noEmit": false
  },
  // Solo i sorgenti TS del wrapper. `dev.mjs` è uno script Node, non va compilato.
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
